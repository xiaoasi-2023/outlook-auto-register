# ============================================
# Outlook Auto Register - 阿里云 ACR 拉取部署示例
# ============================================

# 阿里云镜像地址。ACR 自动构建完成后，服务器 docker compose 会直接拉取这个镜像。
IMAGE_NAME=registry.cn-hangzhou.aliyuncs.com/jiangshitong/outlook-auto-register:latest

# 宿主机对外端口。容器内部面板固定监听 8765。
APP_PORT=8765

# 默认只监听宿主机本地地址，避免直接暴露到公网。
# 如需公网直接访问，改成 0.0.0.0；更推荐保持 127.0.0.1，然后用 Nginx/宝塔反代。
HOST_BIND_ADDR=127.0.0.1

# 服务器运行数据挂载路径。宝塔/普通 VPS 都可以用这个目录。
APP_DATA_DIR=/www/docker/outlook-auto-register

# 默认安全模式：只启动面板，不自动跑注册守护。
# 改成 daemon 才会启动 outlook_daemon.py。
APP_MODE=dashboard

TZ=Asia/Shanghai
SHM_SIZE=1gb

# 可选：代理订阅。逗号分隔多个 URL。
# 也可以不写这里，手动创建：
#   /www/docker/outlook-auto-register/mihomo_runtime/subscriptions.json
SUBSCRIPTION_URL=

# 可选：你自己的私有凭证仓库，仅开启 daemon/推送时需要。
CLOUD_REGISTER_EMAIL_REMOTE=
