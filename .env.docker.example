# Copy to .env before running docker compose.
# Safe default: dashboard only. It will not start the auto-register daemon.
APP_MODE=dashboard
OUTLOOK_DASHBOARD_PORT=8765
TZ=Asia/Shanghai

# Optional. Comma-separated proxy subscription URLs. You can also create:
# docker-data/mihomo_runtime/subscriptions.json
SUBSCRIPTION_URL=

# Optional. Use your own private credential repo if you enable daemon/push.
CLOUD_REGISTER_EMAIL_REMOTE=
